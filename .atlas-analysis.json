  "keyFeatures": [
    "Native macOS UI built with SwiftUI",
    "Privacy-first browsing with content blocking",
    "Vertical sidebar with pinned and favorite tabs",
    "Spaces (tab containers) for organizing browsing",
    "Quick Launcher for instant navigation",
    "Developer mode with integrated tools",
    "Session restore after crashes",
    "Picture-in-Picture support",
    "Private browsing mode",
    "Multiple search engine support"
  ],
  "publicApiSurface": [
    "TabManager - Core tab lifecycle and management",
    "WebViewNavigationDelegate - WebKit navigation handling",
    "HistoryManager - Browsing history management",
    "DownloadManager - File download handling",
    "MediaController - Media playback control",
    "FaviconService - Favicon fetching and caching",
    "SearchEngineService - Search engine configuration",
    "PrivacyService - Privacy and content blocking",
    "AppearanceManager - Theme and appearance settings",
    "DefaultBrowserManager - System default browser integration",
    "UpdateService - Automatic updates via Sparkle"
  ]
